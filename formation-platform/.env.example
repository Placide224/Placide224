# Postgres connection string. Use `docker compose up -d` for a local DB
# matching this default, or point at a hosted provider (Supabase, Neon, Railway...).
DATABASE_URL="postgresql://formation:formation@localhost:5432/formation"

# Generate with: openssl rand -base64 32
AUTH_SECRET="changeme"

# Used by the admin quiz generator (Anthropic API key).
ANTHROPIC_API_KEY=""
