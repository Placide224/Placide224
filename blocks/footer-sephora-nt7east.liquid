{% doc %}
  @prompt
    Footer complet façon Sephora France (services, colonnes de liens réelles,
    réseaux sociaux natifs, sélecteur pays/langue connecté aux vrais marchés
    Shopify, retour accueil, retour en haut) adapté à l'identité NT7East.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture newline %}
{% endcapture %}

{% style %}
  .ai-footer-sephora-{{ ai_gen_id }} {
    display: block;
    width: 100vw;
    max-width: none;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-footer-sephora-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-footer-sephora-{{ ai_gen_id }} a:hover,
  .ai-footer-sephora-{{ ai_gen_id }} a:focus-visible {
    text-decoration: underline;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__services-bar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
  }

  .ai-footer-sephora-{{ ai_gen_id }}__services {
    list-style: none;
    margin: 0;
    padding: 24px 32px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    max-width: 1500px;
    margin-inline: auto;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__service {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__service-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__service-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__service-title {
    margin: 0 0 2px;
    font-weight: 700;
    font-size: 14px;
    line-height: 1.3;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__service-text {
    margin: 0 0 4px;
    font-size: 12px;
    line-height: 1.35;
    opacity: 0.92;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__service-link {
    display: inline-block;
    font-size: 12px;
    text-decoration: underline;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__main {
    padding: 40px 32px 24px;
    max-width: 1500px;
    margin-inline: auto;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 32px;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__heading {
    margin: 0 0 16px;
    font-size: 14px;
    font-weight: 700;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__heading--sm {
    margin-top: 24px;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__list a {
    font-size: 12px;
    line-height: 1.4;
    opacity: 0.92;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__social a:hover,
  .ai-footer-sephora-{{ ai_gen_id }}__social a:focus-visible {
    background-color: rgba(255, 255, 255, 0.12);
    text-decoration: none;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__social svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    padding: 18px 32px;
    max-width: 1500px;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__legal-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 11px;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__legal-links li:not(:last-child)::after {
    content: '|';
    margin-left: 16px;
    opacity: 0.6;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__utilities {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 11px;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__home-link {
    text-underline-offset: 2px;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__locale {
    position: relative;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__locale-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 4px;
    padding: 5px 10px;
    color: inherit;
    font-size: 11px;
    cursor: pointer;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__locale-toggle:hover {
    background-color: rgba(255, 255, 255, 0.12);
  }

  .ai-footer-sephora-{{ ai_gen_id }}__flag {
    display: inline-block;
    width: 18px;
    height: 12px;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__locale-panel {
    position: absolute;
    bottom: calc(100% + 10px);
    right: 0;
    width: 300px;
    max-width: 90vw;
    max-height: 380px;
    background: #ffffff;
    color: #1a1a1a;
    border-radius: 8px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    z-index: 30;
    overflow: hidden;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__locale-panel[hidden] {
    display: none;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__top {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 8px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    flex-shrink: 0;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__top:hover {
    background-color: rgba(255, 255, 255, 0.12);
  }

  .ai-footer-sephora-{{ ai_gen_id }}__top svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .ai-footer-sephora-{{ ai_gen_id }}__copyright {
    margin: 0;
    padding: 0 32px 22px;
    max-width: 1500px;
    margin-inline: auto;
    font-size: 10px;
    opacity: 0.75;
  }

  @media screen and (max-width: 989px) {
    .ai-footer-sephora-{{ ai_gen_id }}__services {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-footer-sephora-{{ ai_gen_id }}__columns {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-footer-sephora-{{ ai_gen_id }}__services {
      grid-template-columns: 1fr;
      padding: 20px;
    }

    .ai-footer-sephora-{{ ai_gen_id }}__main {
      padding: 32px 20px 16px;
    }

    .ai-footer-sephora-{{ ai_gen_id }}__columns {
      grid-template-columns: 1fr;
      gap: 28px;
      text-align: center;
    }

    .ai-footer-sephora-{{ ai_gen_id }}__service {
      text-align: left;
    }

    .ai-footer-sephora-{{ ai_gen_id }}__column--social {
      align-items: center;
      display: flex;
      flex-direction: column;
    }

    .ai-footer-sephora-{{ ai_gen_id }}__social {
      justify-content: center;
    }

    .ai-footer-sephora-{{ ai_gen_id }}__bottom {
      padding: 16px 20px;
      flex-direction: column;
      text-align: center;
    }

    .ai-footer-sephora-{{ ai_gen_id }}__legal-links {
      justify-content: center;
    }

    .ai-footer-sephora-{{ ai_gen_id }}__locale-panel {
      right: 50%;
      transform: translateX(50%);
    }

    .ai-footer-sephora-{{ ai_gen_id }}__copyright {
      padding-left: 20px;
      padding-right: 20px;
      text-align: center;
    }
  }
{% endstyle %}

<div class="ai-footer-sephora-{{ ai_gen_id }}" {{ block.shopify_attributes }}>

  {%- if block.settings.show_services -%}
    <div class="ai-footer-sephora-{{ ai_gen_id }}__services-bar">
      <ul class="ai-footer-sephora-{{ ai_gen_id }}__services">
        {%- for i in (1..4) -%}
          {%- assign key_icon = 'service_' | append: i | append: '_icon' -%}
          {%- assign key_title = 'service_' | append: i | append: '_title' -%}
          {%- assign key_text = 'service_' | append: i | append: '_text' -%}
          {%- assign key_link_text = 'service_' | append: i | append: '_link_text' -%}
          {%- assign key_link_url = 'service_' | append: i | append: '_link_url' -%}
          {%- assign icon = block.settings[key_icon] -%}
          {%- assign s_title = block.settings[key_title] -%}
          {%- assign s_text = block.settings[key_text] -%}
          {%- assign s_link_text = block.settings[key_link_text] -%}
          {%- assign s_link_url = block.settings[key_link_url] -%}
          {%- if s_title != blank -%}
            <li class="ai-footer-sephora-{{ ai_gen_id }}__service">
              <span class="ai-footer-sephora-{{ ai_gen_id }}__service-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20">{%- render 'icon', icon: icon -%}</svg>
              </span>
              <div>
                <p class="ai-footer-sephora-{{ ai_gen_id }}__service-title">{{ s_title }}</p>
                {%- if s_text != blank -%}
                  <p class="ai-footer-sephora-{{ ai_gen_id }}__service-text">{{ s_text }}</p>
                {%- endif -%}
                {%- if s_link_text != blank and s_link_url != blank -%}
                  <a href="{{ s_link_url }}" class="ai-footer-sephora-{{ ai_gen_id }}__service-link">{{ s_link_text }}</a>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  <div class="ai-footer-sephora-{{ ai_gen_id }}__main">
    <div class="ai-footer-sephora-{{ ai_gen_id }}__columns">
      {%- for i in (1..4) -%}
        {%- assign key_col_title = 'column_' | append: i | append: '_title' -%}
        {%- assign key_col_links = 'column_' | append: i | append: '_links' -%}
        {%- assign col_title = block.settings[key_col_title] -%}
        {%- assign col_links = block.settings[key_col_links] -%}
        {%- if col_title != blank -%}
          <div class="ai-footer-sephora-{{ ai_gen_id }}__column">
            <h3 class="ai-footer-sephora-{{ ai_gen_id }}__heading">{{ col_title }}</h3>
            {%- if col_links != blank -%}
              <ul class="ai-footer-sephora-{{ ai_gen_id }}__list">
                {%- assign lines = col_links | split: newline -%}
                {%- for line in lines -%}
                  {%- assign line = line | strip -%}
                  {%- if line != blank -%}
                    {%- assign parts = line | split: '|' -%}
                    {%- assign link_label = parts[0] | strip -%}
                    {%- assign link_url = parts[1] | strip -%}
                    {%- if link_url != blank -%}
                      <li><a href="{{ link_url }}">{{ link_label }}</a></li>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="ai-footer-sephora-{{ ai_gen_id }}__column ai-footer-sephora-{{ ai_gen_id }}__column--social">
        {%- if block.settings.social_heading != blank -%}
          <h3 class="ai-footer-sephora-{{ ai_gen_id }}__heading">{{ block.settings.social_heading }}</h3>
        {%- endif -%}
        <ul class="ai-footer-sephora-{{ ai_gen_id }}__social">
          {%- assign social_platforms = 'facebook,instagram,youtube,tiktok,twitter,threads,linkedin,bluesky,snapchat,pinterest,tumblr,vimeo,discord,telegram,whatsapp,spotify,twitch,mastodon' | split: ',' -%}
          {%- for platform in social_platforms -%}
            {%- assign key_social = platform | append: '_url' -%}
            {%- assign social_url = block.settings[key_social] -%}
            {%- if social_url != blank -%}
              <li>
                <a href="{{ social_url }}" aria-label="{{ platform | capitalize }}" target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 20 20">{%- render 'icon', icon: platform -%}</svg>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
          {%- if block.settings.custom_social_url != blank -%}
            <li>
              <a href="{{ block.settings.custom_social_url }}" aria-label="{{ block.settings.custom_social_label | default: 'Réseau social' }}" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 20 20">{%- render 'icon', icon: 'chat_bubble' -%}</svg>
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>
    </div>
  </div>

  <div class="ai-footer-sephora-{{ ai_gen_id }}__bottom">
    <ul class="ai-footer-sephora-{{ ai_gen_id }}__legal-links">
      {%- if block.settings.legal_link_1_text != blank and block.settings.legal_link_1_url != blank -%}<li><a href="{{ block.settings.legal_link_1_url }}">{{ block.settings.legal_link_1_text }}</a></li>{%- endif -%}
      {%- if block.settings.legal_link_2_text != blank and block.settings.legal_link_2_url != blank -%}<li><a href="{{ block.settings.legal_link_2_url }}">{{ block.settings.legal_link_2_text }}</a></li>{%- endif -%}
      {%- if block.settings.legal_link_3_text != blank and block.settings.legal_link_3_url != blank -%}<li><a href="{{ block.settings.legal_link_3_url }}">{{ block.settings.legal_link_3_text }}</a></li>{%- endif -%}
      {%- if block.settings.legal_link_4_text != blank and block.settings.legal_link_4_url != blank -%}<li><a href="{{ block.settings.legal_link_4_url }}">{{ block.settings.legal_link_4_text }}</a></li>{%- endif -%}
    </ul>

    <div class="ai-footer-sephora-{{ ai_gen_id }}__utilities">
      {%- if block.settings.show_home_link -%}
        <a href="{{ routes.root_url }}" class="ai-footer-sephora-{{ ai_gen_id }}__home-link">{{ block.settings.home_link_text }}</a>
      {%- endif -%}

      {%- if block.settings.show_locale_selector -%}
        <div class="ai-footer-sephora-{{ ai_gen_id }}__locale">
          <button
            type="button"
            class="ai-footer-sephora-{{ ai_gen_id }}__locale-toggle"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="Choisir le pays et la langue"
            data-locale-toggle
          >
            <span class="ai-footer-sephora-{{ ai_gen_id }}__flag" style="background-image:url({{ localization.country | image_url: width: 40 }});" aria-hidden="true"></span>
            <span>{{ localization.country.name }}</span>
          </button>
          <div class="ai-footer-sephora-{{ ai_gen_id }}__locale-panel" hidden data-locale-panel>
            {%- render 'localization-form', show_country: true, show_language: true, form_id: ai_gen_id, localization_style: 'dropdown' -%}
          </div>
        </div>
      {%- endif -%}

      {%- if block.settings.show_back_to_top -%}
        <button type="button" class="ai-footer-sephora-{{ ai_gen_id }}__top" aria-label="Retour en haut de la page" data-back-to-top>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      {%- endif -%}
    </div>
  </div>

  {%- if block.settings.copyright_text != blank -%}
    <p class="ai-footer-sephora-{{ ai_gen_id }}__copyright">{{ block.settings.copyright_text }}</p>
  {%- endif -%}
</div>

<script>
  (function () {
    var scope = document.querySelector('.ai-footer-sephora-{{ ai_gen_id }}');
    if (!scope) return;

    var localeToggle = scope.querySelector('[data-locale-toggle]');
    var localePanel = scope.querySelector('[data-locale-panel]');

    if (localeToggle && localePanel) {
      localeToggle.addEventListener('click', function (event) {
        event.stopPropagation();
        var isOpen = !localePanel.hidden;
        localePanel.hidden = isOpen;
        localeToggle.setAttribute('aria-expanded', String(!isOpen));
      });

      document.addEventListener('click', function (event) {
        if (!localePanel.hidden && !localeToggle.contains(event.target) && !localePanel.contains(event.target)) {
          localePanel.hidden = true;
          localeToggle.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !localePanel.hidden) {
          localePanel.hidden = true;
          localeToggle.setAttribute('aria-expanded', 'false');
          localeToggle.focus();
        }
      });
    }

    var backToTop = scope.querySelector('[data-back-to-top]');
    if (backToTop) {
      backToTop.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Footer Sephora NT7East",
  "settings": [
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background_color", "label": "Fond", "default": "#0057FF" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#FFFFFF" },

    { "type": "header", "content": "Bloc supérieur : services" },
    { "type": "checkbox", "id": "show_services", "label": "Afficher le bloc services", "default": true },

    { "type": "select", "id": "service_1_icon", "label": "Icône 1", "options": [{"value":"box","label":"Retrait / colis"},{"value":"truck","label":"Livraison"},{"value":"lock","label":"Paiement sécurisé"},{"value":"return","label":"Retours"}], "default": "box" },
    { "type": "text", "id": "service_1_title", "label": "Titre 1", "default": "Retrait en magasin" },
    { "type": "text", "id": "service_1_text", "label": "Description 1", "default": "Click & Collect en 2h offert" },
    { "type": "text", "id": "service_1_link_text", "label": "Lien 1 - texte", "default": "En savoir plus" },
    { "type": "url", "id": "service_1_link_url", "label": "Lien 1 - URL" },

    { "type": "select", "id": "service_2_icon", "label": "Icône 2", "options": [{"value":"box","label":"Retrait / colis"},{"value":"truck","label":"Livraison"},{"value":"lock","label":"Paiement sécurisé"},{"value":"return","label":"Retours"}], "default": "truck" },
    { "type": "text", "id": "service_2_title", "label": "Titre 2", "default": "Livraison standard offerte" },
    { "type": "text", "id": "service_2_text", "label": "Description 2", "default": "Tarifs et délais selon votre pays" },
    { "type": "text", "id": "service_2_link_text", "label": "Lien 2 - texte", "default": "Explorer l'offre" },
    { "type": "url", "id": "service_2_link_url", "label": "Lien 2 - URL" },

    { "type": "select", "id": "service_3_icon", "label": "Icône 3", "options": [{"value":"box","label":"Retrait / colis"},{"value":"truck","label":"Livraison"},{"value":"lock","label":"Paiement sécurisé"},{"value":"return","label":"Retours"}], "default": "lock" },
    { "type": "text", "id": "service_3_title", "label": "Titre 3", "default": "Paiements sécurisés" },
    { "type": "text", "id": "service_3_text", "label": "Description 3", "default": "et paiements en plusieurs fois" },
    { "type": "text", "id": "service_3_link_text", "label": "Lien 3 - texte", "default": "En savoir plus" },
    { "type": "url", "id": "service_3_link_url", "label": "Lien 3 - URL" },

    { "type": "select", "id": "service_4_icon", "label": "Icône 4", "options": [{"value":"box","label":"Retrait / colis"},{"value":"truck","label":"Livraison"},{"value":"lock","label":"Paiement sécurisé"},{"value":"return","label":"Retours"}], "default": "return" },
    { "type": "text", "id": "service_4_title", "label": "Titre 4", "default": "Retours" },
    { "type": "text", "id": "service_4_text", "label": "Description 4", "default": "Retours et remplacements" },
    { "type": "text", "id": "service_4_link_text", "label": "Lien 4 - texte", "default": "Retourner un article" },
    { "type": "url", "id": "service_4_link_url", "label": "Lien 4 - URL" },

    { "type": "header", "content": "Colonnes de liens" },
    { "type": "paragraph", "content": "Une ligne par lien, au format Libellé|URL. N'utilisez que des pages réellement créées sur la boutique." },

    { "type": "text", "id": "column_1_title", "label": "Colonne 1 - titre", "default": "Aide" },
    { "type": "textarea", "id": "column_1_links", "label": "Colonne 1 - liens", "default": "Suivre ma commande|/pages/suivre-ma-commande\nMoyens de paiement acceptés|/pages/moyens-de-paiement-securises\nPaiement en plusieurs fois|/pages/paiement-en-plusieurs-fois\nTarifs et modes de livraison|/pages/tarifs-et-modes-de-livraison\nRetours et remplacements|/pages/retours-et-remplacements\nNous contacter|/pages/contact" },

    { "type": "text", "id": "column_2_title", "label": "Colonne 2 - titre", "default": "Mon NT7East" },
    { "type": "textarea", "id": "column_2_links", "label": "Colonne 2 - liens", "default": "Mon compte|/account\nLe Club NT7 (fidélité)|/pages/le-club-nt7-fidelite\nPréférences cookies|/pages/cookies" },

